# Root-level environment file loaded by the backend.
# backend/.env can optionally override values from here.

# Minimal local backend configuration
APP_ENV=development
APP_NAME=Global Supply Chain API
SECRET_KEY=change-me-in-env
SQLITE_DB_PATH=local.db
MOCK_EMAIL_DELIVERY=true

# Optional: comma-separated frontend origins for local/dev access
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI configuration
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
